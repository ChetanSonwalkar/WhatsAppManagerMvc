@model List<WhatsAppManagerMvc.Models.WhatsAppMessage>
@using System.Collections
@using System.Reflection
@using System.Text.RegularExpressions

@functions {
    private object? FindTemplate(object? source, int id)
    {
        if (source is not IEnumerable items)
            return null;

        foreach (var item in items)
        {
            if (item == null)
                continue;

            var value = ReadValue(item, "Id", "WhatsAppTemplateId", "TemplateId");

            if (int.TryParse(value, out var parsed) && parsed == id)
                return item;
        }

        return null;
    }

    private object? GetPropertyValue(object? obj, string name)
    {
        if (obj == null)
            return null;

        var property = obj.GetType().GetProperties(
                BindingFlags.Public | BindingFlags.Instance)
            .FirstOrDefault(p =>
                string.Equals(p.Name, name,
                    StringComparison.OrdinalIgnoreCase));

        try
        {
            return property?.GetValue(obj);
        }
        catch
        {
            return null;
        }
    }

    private string ReadValue(object? obj, params string[] names)
    {
        foreach (var name in names)
        {
            var value = GetPropertyValue(obj, name);

            if (value == null)
                continue;

            if (value is string text)
            {
                if (!string.IsNullOrWhiteSpace(text))
                    return text;

                continue;
            }

            if (value is DateTime || value is DateTimeOffset)
                continue;

            var result = value.ToString();

            if (!string.IsNullOrWhiteSpace(result))
                return result;
        }

        return "";
    }

    private IEnumerable<PropertyInfo> GetTemplateProperties(object? template)
    {
        if (template == null)
            return Enumerable.Empty<PropertyInfo>();

        return template.GetType()
            .GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .Where(p => p.CanRead && p.GetIndexParameters().Length == 0);
    }

    private bool IsImageProperty(PropertyInfo property, object? template)
    {
        var value = GetPropertyValue(template, property.Name)?.ToString();

        if (string.IsNullOrWhiteSpace(value))
            return false;

        var name = property.Name.ToLowerInvariant();
        var isImageField =
            name.Contains("image") ||
            name.Contains("photo") ||
            name.Contains("media") ||
            name.Contains("picture");

        var isUrl = Uri.TryCreate(
            value, UriKind.Absolute, out var uri) &&
            (uri.Scheme == Uri.UriSchemeHttps ||
             uri.Scheme == Uri.UriSchemeHttp);

        if (!isUrl)
            return false;

        var path = uri!.AbsolutePath.ToLowerInvariant();

        var hasImageExtension =
            path.EndsWith(".jpg") ||
            path.EndsWith(".jpeg") ||
            path.EndsWith(".png") ||
            path.EndsWith(".webp") ||
            path.EndsWith(".gif");

        return isImageField || hasImageExtension;
    }

    private string GetTemplateText(object? template)
    {
        return ReadValue(template,
            "Body",
            "BodyText",
            "TemplateBody",
            "MessageBody",
            "TemplateText",
            "MessageText",
            "Content",
            "Text");
    }

    private bool IsVideoProperty(PropertyInfo property, object? source)
    {
        var value = GetPropertyValue(source, property.Name)?.ToString();
        if (string.IsNullOrWhiteSpace(value) || !IsHttpUrl(value))
            return false;

        var name = property.Name.ToLowerInvariant();
        var path = "";
        if (Uri.TryCreate(value, UriKind.Absolute, out Uri? parsed) && parsed != null)
            path = parsed.AbsolutePath.ToLowerInvariant();

        return name.Contains("video") ||
               path.EndsWith(".mp4") || path.EndsWith(".webm") ||
               path.EndsWith(".mov") || path.EndsWith(".m4v") ||
               path.EndsWith(".ogg");
    }

    private bool IsHttpUrl(string value)
    {
        return Uri.TryCreate(value, UriKind.Absolute, out Uri? parsed) &&
               parsed != null &&
               (parsed.Scheme == Uri.UriSchemeHttp ||
                parsed.Scheme == Uri.UriSchemeHttps);
    }

    private bool IsVideoUrl(string value)
    {
        if (!IsHttpUrl(value))
            return false;

        Uri? parsed;
        if (!Uri.TryCreate(value, UriKind.Absolute, out parsed) || parsed == null)
            return false;

        var path = parsed.AbsolutePath.ToLowerInvariant();
        return path.EndsWith(".mp4") || path.EndsWith(".webm") ||
               path.EndsWith(".mov") || path.EndsWith(".m4v") ||
               path.EndsWith(".ogg");
    }

    private bool IsImageUrl(string value)
    {
        if (!IsHttpUrl(value))
            return false;

        Uri? parsed;
        if (!Uri.TryCreate(value, UriKind.Absolute, out parsed) || parsed == null)
            return false;

        var path = parsed.AbsolutePath.ToLowerInvariant();
        return path.EndsWith(".jpg") || path.EndsWith(".jpeg") ||
               path.EndsWith(".png") || path.EndsWith(".webp") ||
               path.EndsWith(".gif") || path.EndsWith(".bmp");
    }

    private IEnumerable<(string Name, string Url)> GetReplyMedia(object? message)
    {
        if (message == null)
            return Enumerable.Empty<(string Name, string Url)>();

        var results = new List<(string Name, string Url)>();
        foreach (var property in GetTemplateProperties(message))
        {
            var name = property.Name.ToLowerInvariant();
            if (!(name.Contains("reply") || name.Contains("media") ||
                  name.Contains("image") || name.Contains("video") ||
                  name.Contains("attachment") || name.Contains("file") ||
                  name.Contains("document") || name.Contains("webhook") ||
                  name.Contains("inbound")))
                continue;

            object? raw;
            try { raw = property.GetValue(message); }
            catch { continue; }

            if (raw == null) continue;
            var value = raw.ToString()?.Trim();
            if (string.IsNullOrWhiteSpace(value) || !IsHttpUrl(value))
                continue;

            if (!results.Any(x => string.Equals(x.Url, value, StringComparison.OrdinalIgnoreCase)))
                results.Add((property.Name, value));
        }

        return results;
    }

    private bool IsMetadataField(string name)
    {
        var key = name.ToLowerInvariant();

        return key is "id"
            or "whatsapptemplateid"
            or "templateid"
            or "templatename"
            or "name"
            or "createdat"
            or "updatedat"
            or "lastsyncat"
            or "isactive";
    }
}

@{
    ViewData["Title"] = "WhatsApp Chat";
    Layout = "_Layout";

    var phoneNumber = ViewBag.PhoneNumber as string ?? "";
    var error = ViewBag.Error as string;
    var templateDetails = ViewBag.TemplateDetails;

    var messages = (Model ?? new List<WhatsAppManagerMvc.Models.WhatsAppMessage>())
        .OrderBy(m => m.CreatedAt ?? m.SentAt)
        .ToList();

    var waNumber = Regex.Replace(phoneNumber, @"\D", "");
}

