<div class="wa-page">
    <section class="hero">
        <div>
            <div class="eyebrow hero-eyebrow">WHATSAPP MANAGER</div>
            <h1>WhatsApp Chat</h1>
            <p>View template content, media and customer replies.</p>
        </div>
        <div class="hero-mark">WA</div>
    </section>

    <section class="wa-shell">
        <div class="wa-header">
            <div class="wa-avatar">WA</div>

            <div class="wa-contact">
                <h2>@phoneNumber</h2>
                <p>WhatsApp message history</p>
            </div>

            <div class="wa-actions">
                <a asp-controller="Dashboard"
                   asp-action="MessageHistory">Back</a>

                <button type="button" id="waRefresh">↻</button>
            </div>
        </div>

        <div class="wa-toolbar">
            <input id="waSearch"
                   class="wa-search"
                   type="search"
                   placeholder="Search template, text or reply..."
                   autocomplete="off" />

            <span class="wa-count" id="waCount">
                @messages.Count messages
            </span>
        </div>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="wa-error">@error</div>
        }

        <div class="wa-body" id="waBody">
            @if (messages.Count == 0)
            {
                <div class="wa-empty">
                    <div style="font-size:36px">💬</div>
                    <h3>No messages found</h3>
                    <p>No message records were returned for this phone number.</p>
                </div>
            }
            else
            {
                DateTime? previousDate = null;

                @foreach (var message in messages)
                {
                    var timestamp = message.SentAt
                        ?? message.CreatedAt
                        ?? message.UpdatedAt;

                    var status = (message.Status ?? "pending")
                        .Trim().ToLowerInvariant();

                    var templateId = message.WhatsAppTemplateId ?? 0;
                    var template = FindTemplate(templateDetails, templateId);

                    var templateName = ReadValue(
                        template, "TemplateName", "Name", "NameTemplate");

                    if (string.IsNullOrWhiteSpace(templateName))
                    {
                        templateName = templateId > 0
                            ? $"Template #{templateId}"
                            : "WhatsApp message";
                    }

                    var bodyText = GetTemplateText(template);
                    var replyText = message.ReplyMessage ?? "";

                    if (timestamp.HasValue &&
                        (!previousDate.HasValue ||
                         previousDate.Value.Date != timestamp.Value.Date))
                    {
                        <div class="wa-date">
                            <span>
                                @timestamp.Value.ToLocalTime().ToString("dd MMM yyyy")
                            </span>
                        </div>

                        previousDate = timestamp;
                    }

                    <div class="wa-row sent wa-message-row"
                         data-search="@($"{templateName} {bodyText} {message.Id} {message.PhoneNumber} {status} {replyText}").ToLowerInvariant()">

                        <div class="wa-bubble">
                            <div class="wa-sender">You · Sent template</div>

                            <div class="wa-template-title">@templateName</div>

                            <span class="wa-template-id">
                                Template ID: @(templateId > 0 ? templateId.ToString() : "N/A")
                            </span>

                            @if (template == null)
                            {
                                <div class="wa-text">
                                    Template details were not found in the template API response.
                                </div>
                            }
                            else
                            {
                                @if (!string.IsNullOrWhiteSpace(bodyText))
                                {
                                    <div class="wa-template-section">
                                        <div class="wa-field-label">Template message</div>
                                        <div class="wa-text">@bodyText</div>
                                    </div>
                                }

                                @foreach (var property in GetTemplateProperties(template))
                                {
                                    var fieldName = property.Name;
                                    var fieldValue = GetPropertyValue(template, fieldName);
                                    var valueText = fieldValue?.ToString() ?? "";

                                    if (IsMetadataField(fieldName) ||
                                        string.IsNullOrWhiteSpace(valueText) ||
                                        string.Equals(fieldName, "Body", StringComparison.OrdinalIgnoreCase) ||
                                        string.Equals(fieldName, "BodyText", StringComparison.OrdinalIgnoreCase) ||
                                        string.Equals(fieldName, "TemplateBody", StringComparison.OrdinalIgnoreCase) ||
                                        string.Equals(fieldName, "MessageBody", StringComparison.OrdinalIgnoreCase) ||
                                        string.Equals(fieldName, "TemplateText", StringComparison.OrdinalIgnoreCase) ||
                                        string.Equals(fieldName, "MessageText", StringComparison.OrdinalIgnoreCase) ||
                                        string.Equals(fieldName, "Content", StringComparison.OrdinalIgnoreCase) ||
                                        string.Equals(fieldName, "Text", StringComparison.OrdinalIgnoreCase))
                                    {
                                        continue;
                                    }

                                    <div class="wa-template-section">
                                        <div class="wa-field-label">@fieldName</div>

                                        @if (IsVideoProperty(property, template) || IsVideoUrl(valueText))
                                        {
                                            <video class="wa-template-video"
                                                   controls
                                                   preload="metadata">
                                                <source src="@valueText" />
                                                Your browser does not support video playback.
                                            </video>
                                            <a class="wa-image-link"
                                               href="@valueText"
                                               target="_blank"
                                               rel="noopener noreferrer">Open video</a>
                                        }
                                        else if (IsImageProperty(property, template) || IsImageUrl(valueText))
                                        {
                                            <a href="@valueText"
                                               target="_blank"
                                               rel="noopener noreferrer">
                                                <img class="wa-template-image"
                                                     src="@valueText"
                                                     alt="@fieldName"
                                                     loading="lazy"
                                                     onerror="this.style.display='none';" />
                                            </a>
                                            <a class="wa-image-link"
                                               href="@valueText"
                                               target="_blank"
                                               rel="noopener noreferrer">Open image</a>
                                        }
                                        else if (IsHttpUrl(valueText))
                                        {
                                            <a class="wa-image-link"
                                               href="@valueText"
                                               target="_blank"
                                               rel="noopener noreferrer">@valueText</a>
                                        }
                                        else
                                        {
                                            <div class="wa-text">@valueText</div>
                                        }

                                    </div>
                                }
                            }

                            <div class="wa-meta">
                                @(timestamp?.ToLocalTime().ToString("hh:mm tt") ?? "")
                                @if (status == "read")
                                {
                                    <span class="wa-ticks read">✓✓</span>
                                }
                                else if (status == "delivered")
                                {
                                    <span class="wa-ticks">✓✓</span>
                                }
                                else if (status == "sent")
                                {
                                    <span class="wa-ticks">✓</span>
                                }
                                else if (status == "failed")
                                {
                                    <span>!</span>
                                }
                            </div>

                            <div class="wa-status">
                                Status: @status
                                @if (message.DeliveredAt.HasValue)
                                {
                                    <span>
                                        · Delivered @message.DeliveredAt.Value.ToLocalTime().ToString("hh:mm tt")
                                    </span>
                                }
                                @if (message.ReadAt.HasValue)
                                {
                                    <span>
                                        · Read @message.ReadAt.Value.ToLocalTime().ToString("hh:mm tt")
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    var replyMedia = GetReplyMedia(message).ToList();
                    var hasReplyText = !string.IsNullOrWhiteSpace(replyText) &&
                        !replyText.Equals("[image message received]", StringComparison.OrdinalIgnoreCase) &&
                        !replyText.Equals("[video message received]", StringComparison.OrdinalIgnoreCase) &&
                        !replyText.Equals("[media message received]", StringComparison.OrdinalIgnoreCase);
                    var hasReply = hasReplyText || replyMedia.Count > 0 ||
                        !string.IsNullOrWhiteSpace(replyText);

                    @if (hasReply)
                    {
                        <div class="wa-row received wa-message-row"
                             data-search="@($"{replyText} {message.CandidateName} {message.PhoneNumber} {string.Join(" ", replyMedia.Select(x => x.Url))}").ToLowerInvariant()">
                            <div class="wa-bubble">
                                <div class="wa-sender">
                                    @(string.IsNullOrWhiteSpace(message.CandidateName)
                                        ? "Customer"
                                        : message.CandidateName)
                                </div>

                                @if (hasReplyText)
                                {
                                    <div class="wa-text">@replyText</div>
                                }

                                @foreach (var media in replyMedia)
                                {
                                    if (IsVideoUrl(media.Url) ||
                                        media.Name.Contains("video", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <video class="wa-reply-video" controls preload="metadata">
                                            <source src="@media.Url" />
                                            Your browser does not support video playback.
                                        </video>
                                        <a class="wa-image-link"
                                           href="@media.Url"
                                           target="_blank"
                                           rel="noopener noreferrer">Open video</a>
                                    }
                                    else if (IsImageUrl(media.Url) ||
                                             media.Name.Contains("image", StringComparison.OrdinalIgnoreCase) ||
                                             media.Name.Contains("photo", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <a href="@media.Url" target="_blank" rel="noopener noreferrer">
                                            <img class="wa-reply-image"
                                                 src="@media.Url"
                                                 alt="Customer image"
                                                 loading="lazy"
                                                 onerror="this.style.display='none';" />
                                        </a>
                                        <a class="wa-image-link"
                                           href="@media.Url"
                                           target="_blank"
                                           rel="noopener noreferrer">Open image</a>
                                    }
                                    else
                                    {
                                        <a class="wa-image-link"
                                           href="@media.Url"
                                           target="_blank"
                                           rel="noopener noreferrer">@media.Name</a>
                                    }
                                }

                                @if (replyMedia.Count == 0 && !hasReplyText &&
                                     !string.IsNullOrWhiteSpace(replyText))
                                {
                                    <div class="wa-media-label">@replyText</div>
                                }

                                <div class="wa-meta">
                                    @(message.ReplyReceivedAt?.ToLocalTime()
                                        .ToString("hh:mm tt") ?? "")
                                </div>
                            </div>
                        </div>
                    }
                }
            }

            <div class="wa-empty" id="waNoResults" hidden>
                <h3>No matching messages</h3>
                <p>Try another search term.</p>
            </div>
        </div>

        <form id="waTextForm" class="wa-composer">
            <textarea id="waTextMessage"
                      class="wa-composer-input"
                      rows="1"
                      maxlength="4096"
                      placeholder="Type a message..."
                      aria-label="Type a WhatsApp message"></textarea>

            <button type="submit"
                    id="waSendTextButton"
                    class="wa-send-text"
                    aria-label="Open WhatsApp to send message"
                    title="Send message">
                ➤
            </button>
        </form>
        <div class="wa-composer-note">
            Send opens WhatsApp with your message pre-filled. Confirm and send it in WhatsApp.
        </div>

    </section>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const body = document.getElementById("waBody");
        const search = document.getElementById("waSearch");
        const count = document.getElementById("waCount");
        const noResults = document.getElementById("waNoResults");
        const refresh = document.getElementById("waRefresh");

        if (!body) return;

        const rows = Array.from(body.querySelectorAll(".wa-message-row"));

        function filterMessages() {
            const term = (search?.value || "").trim().toLowerCase();
            let visible = 0;

            rows.forEach(function (row) {
                const text = (
                    row.innerText + " " + (row.dataset.search || "")
                ).toLowerCase();

                row.hidden = !!term && !text.includes(term);

                if (!row.hidden) visible++;
            });

            body.querySelectorAll(".wa-date").forEach(function (date) {
                let next = date.nextElementSibling;
                let found = false;

                while (next && !next.classList.contains("wa-date")) {
                    if (next.classList.contains("wa-message-row") && !next.hidden) {
                        found = true;
                        break;
                    }

                    next = next.nextElementSibling;
                }

                date.hidden = !found;
            });

            if (count) count.textContent = visible + " messages";
            if (noResults) noResults.hidden = visible > 0;
        }

        search?.addEventListener("input", filterMessages);

        refresh?.addEventListener("click", function () {
            window.location.reload();
        });


        const textForm = document.getElementById("waTextForm");
        const textInput = document.getElementById("waTextMessage");
        const sendTextButton = document.getElementById("waSendTextButton");

        if (textInput && sendTextButton) {
            textInput.addEventListener("input", function () {
                sendTextButton.disabled = !textInput.value.trim();
                textInput.style.height = "auto";
                textInput.style.height = Math.min(textInput.scrollHeight, 130) + "px";
            });

            sendTextButton.disabled = !textInput.value.trim();
        }

        if (textForm && textInput) {
            textForm.addEventListener("submit", function (event) {
                event.preventDefault();

                const text = textInput.value.trim();
                const phone = "@waNumber";

                if (!text) {
                    textInput.focus();
                    return;
                }

                if (!phone) {
                    alert("Phone number is missing.");
                    return;
                }

                const url = "https://wa.me/" + phone +
                    "?text=" + encodeURIComponent(text);

                window.open(url, "_blank", "noopener,noreferrer");
            });
        }

        body.scrollTop = body.scrollHeight;
    });
</script>
