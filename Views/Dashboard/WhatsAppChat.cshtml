@model List<WhatsAppManagerMvc.Models.WhatsAppMessage>
@using System
@using System.Linq
@using System.Collections.Generic

@{
    ViewData["Title"] = "WhatsApp Chat";

    var phoneNumber = ViewBag.PhoneNumber?.ToString() ?? "";
    var candidateName = ViewBag.CandidateName?.ToString();

    if (string.IsNullOrWhiteSpace(candidateName))
    {
        candidateName = phoneNumber;
    }

    var messages = (Model ?? new List<WhatsAppManagerMvc.Models.WhatsAppMessage>())
        .OrderBy(m => m.CreatedAt ?? m.SentAt ?? DateTime.MinValue)
        .ToList();

    var templateImages =
        ViewBag.TemplateImageUrls as Dictionary<int, string>
        ?? new Dictionary<int, string>();

    var whatsappTemplates =
        ViewBag.WhatsAppTemplates as IEnumerable<WhatsAppManagerMvc.Models.WhatsAppTemplate>
        ?? Enumerable.Empty<WhatsAppManagerMvc.Models.WhatsAppTemplate>();
}


<div class="wa-chat">

    <div class="wa-header">
        <div class="wa-contact">
            <div class="wa-avatar">WA</div>

            <div>
                <div class="wa-name">@candidateName</div>
                <div class="wa-phone">@phoneNumber</div>
            </div>
        </div>

        <div class="wa-header-actions">
            <a href="@Url.Action("MessageHistory", "Dashboard")">Back</a>
            <button type="button" id="waRefresh" title="Refresh">↻</button>
        </div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="wa-alert wa-error">@ViewBag.Error</div>
    }

    @if (ViewBag.Notice != null)
    {
        <div class="wa-alert wa-success">@ViewBag.Notice</div>
    }

    <div class="wa-search">
        <input id="waSearch"
               type="search"
               placeholder="Search messages..." />

        <span id="waCount" class="wa-count">
            @messages.Count messages
        </span>
    </div>

    <div class="wa-messages" id="waMessages">

        @if (messages.Count == 0)
        {
            <div class="wa-empty">No messages found.</div>
        }

        @foreach (var message in messages)
        {
            var direction = (message.Direction ?? "").Trim();

            var outgoing =
                direction.Equals("Outgoing", StringComparison.OrdinalIgnoreCase) ||
                direction.Equals("Outbound", StringComparison.OrdinalIgnoreCase) ||
                direction.Equals("Sent", StringComparison.OrdinalIgnoreCase);

            var type = (message.MessageType ?? "").Trim().ToLowerInvariant();
            var status = (message.Status ?? "").Trim().ToLowerInvariant();
            var bodyText = message.MessageText ?? "";
            var mediaUrl = message.MediaUrl;

            // The chat API may return MediaId instead of a direct media URL.
            // Use the WhatsApp media endpoint to render incoming and outgoing images.
            if (string.IsNullOrWhiteSpace(mediaUrl) &&
                !string.IsNullOrWhiteSpace(message.MediaId))
            {
                mediaUrl = "https://whatsapp.ciitstudent.com/api/WhatsApp/media/" +
                           Uri.EscapeDataString(message.MediaId.Trim());
            }

            var messageDate = message.CreatedAt ?? message.SentAt;

            var templateId = message.WhatsAppTemplateId;
            dynamic? selectedTemplate = null;
            string? templateImageUrl = null;

            var imageTemplateCandidates = new List<dynamic>();
            foreach (var templateItem in whatsappTemplates)
            {
                dynamic candidate = templateItem;
                int candidateId = 0;
                string? headerFormat = null;
                try { candidateId = Convert.ToInt32(candidate.Id); } catch { }
                try { headerFormat = Convert.ToString(candidate.HeaderFormat); } catch { }

                if (string.Equals(headerFormat, "IMAGE", StringComparison.OrdinalIgnoreCase))
                {
                    imageTemplateCandidates.Add(candidate);
                }

                if (templateId.HasValue && candidateId == templateId.Value)
                {
                    selectedTemplate = candidate;
                    break;
                }

                if (!templateId.HasValue &&
                    string.Equals(headerFormat, "IMAGE", StringComparison.OrdinalIgnoreCase))
                {
                    string? candidateBody = null;
                    try { candidateBody = Convert.ToString(candidate.BodyText); } catch { }

                    static string NormalizeTemplateText(string? value)
                    {
                        if (string.IsNullOrWhiteSpace(value))
                            return string.Empty;

                        return string.Join(
                            " ",
                            value.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries))
                            .Trim();
                    }

                    var normalizedMessage = NormalizeTemplateText(bodyText);
                    var normalizedCandidate = NormalizeTemplateText(candidateBody);

                    if (!string.IsNullOrWhiteSpace(normalizedMessage) &&
                        !string.IsNullOrWhiteSpace(normalizedCandidate) &&
                        (string.Equals(
                            normalizedMessage,
                            normalizedCandidate,
                            StringComparison.OrdinalIgnoreCase) ||
                         normalizedMessage.Contains(normalizedCandidate, StringComparison.OrdinalIgnoreCase) ||
                         normalizedCandidate.Contains(normalizedMessage, StringComparison.OrdinalIgnoreCase)))
                    {
                        selectedTemplate = candidate;
                        break;
                    }
                }
            }

          
            if (selectedTemplate == null && !templateId.HasValue && imageTemplateCandidates.Count == 1)
            {
                selectedTemplate = imageTemplateCandidates[0];
            }

            if (selectedTemplate != null)
            {
                try { templateImageUrl = Convert.ToString(selectedTemplate.HeaderImageUrl); } catch { }
            }

            if (string.IsNullOrWhiteSpace(templateImageUrl) && templateId.HasValue)
            {
                templateImages.TryGetValue(templateId.Value, out templateImageUrl);
            }

            var isImageTemplate =
                type.Contains("imagetemplate", StringComparison.OrdinalIgnoreCase);

           
            if (isImageTemplate &&
                string.IsNullOrWhiteSpace(mediaUrl) &&
                !string.IsNullOrWhiteSpace(templateImageUrl))
            {
                mediaUrl = templateImageUrl;
            }

            

            string? templateName = null;
            string? templateBodyText = null;
            if (selectedTemplate != null)
            {
                try { templateName = Convert.ToString(selectedTemplate.TemplateName); } catch { }
                try { templateBodyText = Convert.ToString(selectedTemplate.BodyText); } catch { }
            }

            var isImage =
                type.Contains("image", StringComparison.OrdinalIgnoreCase) ||
                isImageTemplate ||
                (!string.IsNullOrWhiteSpace(mediaUrl) &&
                 (mediaUrl.Split('?')[0].EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) ||
                  mediaUrl.Split('?')[0].EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) ||
                  mediaUrl.Split('?')[0].EndsWith(".png", StringComparison.OrdinalIgnoreCase) ||
                  mediaUrl.Split('?')[0].EndsWith(".webp", StringComparison.OrdinalIgnoreCase)));

            var isImagePlaceholder =
                bodyText.Contains("[image message received]", StringComparison.OrdinalIgnoreCase) ||
                bodyText.Contains("[image message sent]", StringComparison.OrdinalIgnoreCase) ||
                isImageTemplate;

            var isVideo = type.Contains("video");
            var isAudio = type.Contains("audio") || type.Contains("voice");
            var isDocument = type.Contains("document") || type.Contains("file");

            <div class="wa-row @(outgoing ? "outgoing" : "incoming")"
                 data-search="@($"{bodyText} {message.FileName} {type} {status}".ToLowerInvariant())">

                <div class="wa-bubble @(isImageTemplate ? "wa-image-template-bubble" : "")">

                    <div class="wa-sender">
                        @(outgoing ? "You" : candidateName)
                    </div>

                    @if (isImageTemplate)
                    {
                        <div class="wa-template-name">
                            @(string.IsNullOrWhiteSpace(templateName) ? "WhatsApp Image Template" : templateName)
                        </div>
                    }

                    @if (isImage && !string.IsNullOrWhiteSpace(mediaUrl))
                    {
                        <a class="wa-image-link"
                           href="@mediaUrl"
                           target="_blank"
                           rel="noopener noreferrer">

                            <img class="wa-media"
                                 src="@mediaUrl"
                                 alt="WhatsApp image"
                                 loading="lazy"
                                 onerror="this.style.display='none';this.parentElement.nextElementSibling.hidden=false;" />
                        </a>

                        <div class="wa-attachment" hidden>
                            Image preview unavailable.
                            <a href="@mediaUrl"
                               target="_blank"
                               rel="noopener noreferrer">Open image</a>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(mediaUrl) && isVideo)
                    {
                        <video class="wa-video" controls preload="metadata">
                            <source src="@mediaUrl" />
                            Your browser does not support video playback.
                        </video>
                    }
                    else if (!string.IsNullOrWhiteSpace(mediaUrl) && isAudio)
                    {
                        <audio class="wa-audio" controls preload="metadata">
                            <source src="@mediaUrl" />
                        </audio>
                    }
                    else if (!string.IsNullOrWhiteSpace(mediaUrl) && isDocument)
                    {
                        <div class="wa-attachment">
                            <a href="@mediaUrl"
                               target="_blank"
                               rel="noopener noreferrer">
                                📎 @(string.IsNullOrWhiteSpace(message.FileName)
                                                                                                                                                                                                                                    ? "Open attachment"
                                                                                                                                                                                                                                    : message.FileName)
                            </a>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(mediaUrl))
                    {
                        <div class="wa-attachment">
                            <a href="@mediaUrl"
                               target="_blank"
                               rel="noopener noreferrer">
                                📎 @(string.IsNullOrWhiteSpace(message.FileName)
                                                                                                                                                                                                                                    ? "Open attachment"
                                                                                                                                                                                                                                    : message.FileName)
                            </a>
                        </div>
                    }

                    @{
                        var displayBodyText = bodyText;

                        if (string.IsNullOrWhiteSpace(displayBodyText) ||
                            displayBodyText.Equals("[image message received]", StringComparison.OrdinalIgnoreCase) ||
                            displayBodyText.Equals("[image message sent]", StringComparison.OrdinalIgnoreCase))
                        {
                            displayBodyText = templateBodyText ?? string.Empty;
                        }

                        var needsReadMore = displayBodyText.Length > 180;
                        var textElementId = "waBody_" + message.Id;
                    }

                    @if (!string.IsNullOrWhiteSpace(displayBodyText))
                    {
                        <div class="wa-text">
                            <div id="@textElementId"
                                 class="wa-text-content @(needsReadMore ? "collapsed" : "")">
                                @displayBodyText
                            </div>

                            @if (needsReadMore)
                            {
                                <button type="button"
                                        class="wa-read-more"
                                        data-target="@textElementId"
                                        aria-expanded="false">
                                    Read more
                                </button>
                            }
                        </div>
                    }

                    @if (isImagePlaceholder && string.IsNullOrWhiteSpace(mediaUrl))
                    {
                        <div class="wa-text">
                            Image template detected, but no accessible image URL was returned.
                        </div>
                    }

                    <div class="wa-meta">
                        @(messageDate.HasValue
                            ? messageDate.Value.ToLocalTime().ToString("dd MMM, hh:mm tt")
                            : "")

                        @if (outgoing)
                        {
                            <span class="wa-ticks @(status == "read" ? "read" : "")">
                                @(status == "read" || status == "delivered" ? "✓✓" : "✓")
                            </span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(status))
                    {
                        <div class="wa-meta">Status: @status</div>
                    }

                </div>
            </div>
        }
    </div>

    <form asp-controller="Dashboard"
          asp-action="SendReply"
          method="post"
          enctype="multipart/form-data"
          id="waForm">

        @Html.AntiForgeryToken()

        <input type="hidden" name="phoneNumber" value="@phoneNumber" />
        <input type="hidden" name="messageType" id="waMessageType" value="text" />
        <input type="hidden" name="caption" id="waCaption" value="" />

        <input class="wa-hidden"
               type="file"
               id="waFile"
               name="file" />

        <div class="wa-composer">

            <div class="wa-composer-row">

                <div class="wa-plus-wrap">
                    <button type="button"
                            class="wa-plus"
                            id="waPlus">
                        +
                    </button>

                    <div class="wa-options" id="waOptions">

                        <button type="button"
                                class="wa-option"
                                data-kind="image">
                            ▧ Photos
                        </button>

                        <button type="button"
                                class="wa-option"
                                data-kind="document">
                            ▤ Documents
                        </button>

                        <button type="button"
                                class="wa-option"
                                data-kind="video">
                            ▷ Videos
                        </button>

                        <button type="button"
                                class="wa-option"
                                data-kind="audio">
                            ♫ Audio
                        </button>
                    </div>
                </div>

                <input type="text"
                       name="text"
                       id="waText"
                       class="wa-input"
                       placeholder="Type a message..."
                       autocomplete="off" />

                <button type="submit"
                        id="waSend"
                        class="wa-send"
                        title="Send">
                    ➤
                </button>

            </div>

            <div class="wa-file-info" id="waFileInfo" hidden>
                <span id="waFileName"></span>
                <button type="button" id="waClearFile">X</button>
            </div>

        </div>
    </form>
</div>


