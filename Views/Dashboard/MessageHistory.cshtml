@model WhatsAppManagerMvc.Models.DashboardViewModel

@{
    ViewData["Title"] = "Message History";

    var start = Model.TotalMessages == 0
        ? 0
        : ((Model.Page - 1) * Model.PageSize) + 1;

    var end = Math.Min(
        Model.Page * Model.PageSize,
        Model.TotalMessages);

    var statuses = new[]
    {
        "All", "sent", "delivered", "read", "failed", "pending"
    };

    var templateNames = ViewBag.TemplateNames as Dictionary<int, string>
        ?? new Dictionary<int, string>();
}

<section class="hero">
    <div>
        <div class="eyebrow hero-eyebrow">ACTIVITY</div>
        <h1>Message History</h1>
        <p>Search and review WhatsApp message delivery records.</p>
    </div>

    @* <div class="hero-mark">CIIT</div> *@

    <div class="hero-mark">
        <img src="~/images/logo.png"
             alt="CIIT Institute Logo" class="hero-mark" />
    </div>

</section>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert danger">@Model.Error</div>
}

@if (!string.IsNullOrWhiteSpace(Model.Notice))
{
    <div class="alert success">@Model.Notice</div>
}

<section class="panel">
    <div class="panel-heading">
        <div>
            <div class="eyebrow">MESSAGE RECORDS</div>
            <h2>All Messages</h2>
        </div>

        <div class="history-actions">
            <span class="count-pill">@Model.TotalMessages Records</span>

            <button type="button" class="new-chat-button" id="openNewChat">
                <span aria-hidden="true">＋</span> New Chat
            </button>

            <a class="button-secondary"
               asp-controller="Dashboard"
               asp-action="Index">
                ← Bulk Message
            </a>
        </div>
    </div>

    <form id="messageFilterForm"
          method="get"
          asp-controller="Dashboard"
          asp-action="MessageHistory"
          class="filter-row">

        <input id="messageSearch"
               class="form-control"
               type="search"
               name="search"
               value="@Model.Search"
               placeholder="Search name, phone, template or ID..."
               aria-label="Search messages"
               autocomplete="off" />

        <select id="messageStatus"
                class="form-control"
                name="status"
                aria-label="Filter by status">

            @foreach (var item in statuses)
            {
                if (string.Equals(
                    Model.Status ?? "All",
                    item,
                    StringComparison.OrdinalIgnoreCase))
                {
                    <option value="@item" selected>@item</option>
                }
                else
                {
                    <option value="@item">@item</option>
                }
            }
        </select>

        <input type="hidden"
               id="filterPage"
               name="page"
               value="1" />

        <input type="hidden"
               name="pageSize"
               value="@Model.PageSize" />

        <button class="icon-button search-button"
                type="submit"
                title="Search"
                aria-label="Search">
            ⌕
        </button>

        <a class="icon-button refresh"
           asp-controller="Dashboard"
           asp-action="MessageHistory"
           title="Clear filters and refresh"
           aria-label="Clear filters and refresh">
            ↻
        </a>
    </form>

    <div class="table-wrap">
        <table class="message-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Candidate / Phone</th>
                    <th>Template Name</th>
                    <th>Status</th>
                    <th>Sent At</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Messages == null || Model.Messages.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="empty-cell">
                            No messages found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var message in Model.Messages)
                    {
                        var state = string.IsNullOrWhiteSpace(message.Status)
                            ? "unknown"
                            : message.Status.Trim().ToLowerInvariant();

                        var templateName = "Unknown template";

                        if (message.WhatsAppTemplateId.HasValue)
                        {
                            var templateId = message.WhatsAppTemplateId.Value;

                            if (templateNames.TryGetValue(
                                templateId,
                                out var foundTemplateName)
                                && !string.IsNullOrWhiteSpace(foundTemplateName))
                            {
                                templateName = foundTemplateName;
                            }
                            else
                            {
                                templateName = $"Template #{templateId}";
                            }
                        }

                        <tr>
                            <td class="id-cell">@message.Id</td>

                            <td>
                                <a class="candidate-link"
                                   asp-controller="Dashboard"
                                   asp-action="MessageDetails"
                                   asp-route-phoneNumber="@message.PhoneNumber">
                                    @(string.IsNullOrWhiteSpace(message.CandidateName)
                                        ? "Unknown candidate"
                                        : message.CandidateName)
                                </a>

                                <a class="phone-link"
                                   asp-controller="Dashboard"
                                   asp-action="MessageDetails"
                                   asp-route-phoneNumber="@message.PhoneNumber">
                                    @message.PhoneNumber
                                </a>
                            </td>

                            <td>
                                <span class="template-name-cell">
                                    @templateName
                                </span>
                            </td>

                            <td>
                                <span class="status-badge @state">
                                    @state
                                </span>
                            </td>

                            <td class="date-cell">
                                @(message.SentAt?.ToLocalTime()
                                    .ToString("dd MMM yyyy, hh:mm tt")
                                  ?? message.CreatedAt?.ToLocalTime()
                                    .ToString("dd MMM yyyy, hh:mm tt")
                                  ?? "—")
                            </td>


                            
                            <td>
                                <a class="whatsapp-chat-button"
                                   asp-controller="Dashboard"
                                   asp-action="WhatsAppChat"
                                   asp-route-phoneNumber="@message.PhoneNumber">
                                    <span class="whatsapp-icon">☏</span>
                                    WhatsApp Chat
                                </a>
                            </td>


                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="pagination-row">
        <form method="get"
              asp-controller="Dashboard"
              asp-action="MessageHistory"
              class="rows-form">

            <input type="hidden" name="search" value="@Model.Search" />
            <input type="hidden" name="status" value="@Model.Status" />
            <input type="hidden" name="page" value="1" />

            <label for="pageSize">Rows</label>

            <select id="pageSize"
                    name="pageSize"
                    class="form-control compact-select"
                    onchange="this.form.submit()">

                @foreach (var size in new[] { 10, 25, 50, 100 })
                {
                    if (Model.PageSize == size)
                    {
                        <option value="@size" selected>@size</option>
                    }
                    else
                    {
                        <option value="@size">@size</option>
                    }
                }
            </select>
        </form>

        <span class="page-info">
            Showing @start–@end of @Model.TotalMessages
        </span>

        <div class="page-actions">
            @if (Model.Page > 1)
            {
                <a class="page-button"
                   asp-controller="Dashboard"
                   asp-action="MessageHistory"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status"
                   asp-route-page="@(Model.Page - 1)"
                   asp-route-pageSize="@Model.PageSize">‹</a>
            }
            else
            {
                <span class="page-button disabled">‹</span>
            }

            <span class="page-number">
                Page @Model.Page of @Model.TotalPages
            </span>

            @if (Model.Page < Model.TotalPages)
            {
                <a class="page-button"
                   asp-controller="Dashboard"
                   asp-action="MessageHistory"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status"
                   asp-route-page="@(Model.Page + 1)"
                   asp-route-pageSize="@Model.PageSize">›</a>
            }
            else
            {
                <span class="page-button disabled">›</span>
            }
        </div>
    </div>

    <p class="footnote">
        Select a candidate name or phone number to view its message details.
    </p>
</section>

<div class="new-chat-overlay" id="newChatModal" aria-hidden="true">
    <section class="new-chat-dialog" role="dialog" aria-modal="true" aria-labelledby="newChatTitle">
        <button type="button" class="new-chat-close" id="closeNewChat" aria-label="Close">×</button>
        <div class="new-chat-icon" aria-hidden="true">☏</div>
        <h2 id="newChatTitle">Start a New Chat</h2>
        <p>Enter a WhatsApp mobile number to open its chat.</p>

        <form asp-controller="Dashboard" asp-action="WhatsAppChat" method="get" id="newChatForm">
            <label for="newChatPhone">Mobile Number</label>
            <div class="new-chat-phone-wrap">
                <span>＋</span>
                <input id="newChatPhone" name="phoneNumber" type="tel" inputmode="numeric"
                       autocomplete="tel" maxlength="16" placeholder="Enter 10-digit mobile number"
                       aria-describedby="newChatHint newChatError" required />
            </div>
            <small id="newChatHint">Indian numbers: enter 10 digits or include country code 91.</small>
            <div class="new-chat-error" id="newChatError" role="alert"></div>
            <button type="submit" class="new-chat-submit">Open Chat <span aria-hidden="true">→</span></button>
        </form>
    </section>
</div>

<style>
    .hero-logo {
        display: block;
        max-width: 150px;
        max-height: 64px;
        width: auto;
        height: auto;
        object-fit: contain;
    }

    .history-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        flex-wrap: wrap;
    }

    .new-chat-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        border: 0;
        border-radius: 9px;
        padding: 10px 15px;
        background: #087e70;
        color: #fff;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 3px 8px rgba(8,126,112,.15);
    }

        .new-chat-button:hover, .new-chat-submit:hover {
            background: #06685e;
        }

    .new-chat-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 18px;
        background: rgba(15,30,40,.52);
    }

        .new-chat-overlay.is-open {
            display: flex;
        }

    .new-chat-dialog {
        position: relative;
        width: min(100%,420px);
        padding: 27px;
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 20px 70px rgba(0,0,0,.24);
    }

    .new-chat-close {
        position: absolute;
        top: 10px;
        right: 13px;
        width: 34px;
        height: 34px;
        border: 0;
        border-radius: 50%;
        background: #f1f5f7;
        color: #40505a;
        font-size: 24px;
        cursor: pointer;
    }

    .new-chat-icon {
        display: flex;
        width: 48px;
        height: 48px;
        align-items: center;
        justify-content: center;
        margin-bottom: 13px;
        border-radius: 15px;
        background: #dff7ef;
        color: #087e70;
        font-size: 25px;
    }

    .new-chat-dialog h2 {
        margin: 0 0 7px;
        color: #153b3a;
        font-size: 23px;
    }

    .new-chat-dialog p {
        margin: 0 0 22px;
        color: #687780;
        font-size: 14px;
    }

    .new-chat-dialog label {
        display: block;
        margin-bottom: 7px;
        color: #30444c;
        font-size: 13px;
        font-weight: 700;
    }

    .new-chat-phone-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
        border: 1px solid #cfdde2;
        border-radius: 10px;
        padding: 0 12px;
    }

        .new-chat-phone-wrap:focus-within {
            border-color: #087e70;
            box-shadow: 0 0 0 3px rgba(8,126,112,.1);
        }

        .new-chat-phone-wrap span {
            color: #087e70;
            font-weight: 700;
        }

        .new-chat-phone-wrap input {
            width: 100%;
            min-width: 0;
            height: 46px;
            border: 0;
            outline: 0;
            background: transparent;
            color: #23343b;
            font: inherit;
        }

    #newChatHint {
        display: block;
        margin-top: 8px;
        color: #74818a;
        font-size: 12px;
    }

    .new-chat-error {
        min-height: 18px;
        margin-top: 5px;
        color: #c0392b;
        font-size: 12px;
    }

    .new-chat-submit {
        display: flex;
        width: 100%;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 12px;
        padding: 12px 16px;
        border: 0;
        border-radius: 10px;
        background: #087e70;
        color: #fff;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
    }

    body.new-chat-modal-open {
        overflow: hidden;
    }

    @@media (max-width:600px) {
        .history-actions {
            justify-content: flex-start;
        }

        .new-chat-dialog {
            padding: 23px 19px;
        }
    }
</style>

<script>
    (() => {
        const modal = document.getElementById('newChatModal');
        const openButton = document.getElementById('openNewChat');
        const closeButton = document.getElementById('closeNewChat');
        const phoneInput = document.getElementById('newChatPhone');
        const form = document.getElementById('newChatForm');
        const errorBox = document.getElementById('newChatError');

        function openModal() {
            modal.classList.add('is-open');
            modal.setAttribute('aria-hidden', 'false');
            document.body.classList.add('new-chat-modal-open');
            errorBox.textContent = '';
            window.setTimeout(() => phoneInput.focus(), 50);
        }

        function closeModal() {
            modal.classList.remove('is-open');
            modal.setAttribute('aria-hidden', 'true');
            document.body.classList.remove('new-chat-modal-open');
            openButton.focus();
        }

        openButton.addEventListener('click', openModal);
        closeButton.addEventListener('click', closeModal);
        modal.addEventListener('click', event => { if (event.target === modal) closeModal(); });
        document.addEventListener('keydown', event => { if (event.key === 'Escape' && modal.classList.contains('is-open')) closeModal(); });

        form.addEventListener('submit', event => {
            const raw = phoneInput.value.trim();
            let digits = raw.replace(/\D/g, '');
            if (digits.startsWith('00')) digits = digits.substring(2);
            if (digits.length === 10) digits = '91' + digits;
            if (digits.length === 11 && digits.startsWith('0')) digits = '91' + digits.substring(1);

            if (!/^91[6-9]\d{9}$/.test(digits)) {
                event.preventDefault();
                errorBox.textContent = 'Enter a valid 10-digit Indian mobile number or a number with country code 91.';
                return;
            }

            phoneInput.value = digits;
        });
    })();
</script>

