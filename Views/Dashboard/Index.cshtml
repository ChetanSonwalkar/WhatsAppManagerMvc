@model WhatsAppManagerMvc.Models.DashboardViewModel

@{
    ViewData["Title"] = "WhatsApp Manager";
}

<div class="bulk-page">

    <section class="hero">
        <div>
            <div class="eyebrow hero-eyebrow">WHATSAPP BUSINESS</div>
            <h1>WhatsApp Manager</h1>
            <p>Bulk Messaging Dashboard</p>
        </div>

      @*   <img src="~/images/logo.png"
             alt="CIIT Logo"
             style="width: 150px; height: 60px; object-fit: contain;" /> *@

        @* <div class="hero-mark">CIIT</div> *@

        <div class="hero-mark">
            <img src="~/images/logo.png"
                 alt="CIIT Institute Logo" class="hero-mark"/>
        </div>

    </section>

    @if (!string.IsNullOrWhiteSpace(Model.Notice))
    {
        <div class="alert success">@Model.Notice</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert danger">@Model.Error</div>
    }

    <section class="panel">

        <div class="panel-heading bulk-heading">
            <div class="panel-title">
                <div class="eyebrow">CAMPAIGN</div>
                <h2>Bulk Message</h2>
            </div>

            <div class="heading-actions">
                <span class="count-pill">
                    @(Model.Templates?.Count ?? 0) Templates
                </span>

                <a class="button-secondary history-header-button"
                   asp-controller="Dashboard"
                   asp-action="MessageHistory">
                    <span aria-hidden="true">▤</span>
                    <span>Message History</span>
                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>

        <form asp-controller="Dashboard"
              asp-action="SendBulk"
              method="post"
              enctype="multipart/form-data"
              id="bulkForm">

            @Html.AntiForgeryToken()

            <div class="field">

                <label for="templateSearch">WhatsApp Template</label>

                <div class="template-row">

                    <div class="dropdown-wrap"
                         id="templateDropdownWrap">

                        <input id="templateSearch"
                               name="templateSearch"
                               class="form-control template-search"
                               type="text"
                               placeholder="Select or search template"
                               autocomplete="off"
                               aria-expanded="false"
                               aria-controls="templateOptions"
                               aria-haspopup="listbox"
                               required />

                        <span class="dropdown-chevron"
                              aria-hidden="true">⌄</span>

                        <div id="templateOptions"
                             class="dropdown-options"
                             role="listbox">

                            @if (Model.Templates != null && Model.Templates.Any())
                            {
                                @foreach (var template in Model.Templates)
                                {
                                    <button type="button"
                                            class="template-option"
                                            data-id="@template.Id"
                                            data-name="@template.TemplateName"
                                            role="option"
                                            aria-selected="false">

                                        <span>@template.TemplateName</span>
                                        <small>ID: @template.Id</small>

                                    </button>
                                }
                            }
                            else
                            {
                                <div class="template-empty-message">
                                    No templates available.
                                </div>
                            }

                        </div>
                    </div>

                    <a class="icon-button refresh"
                       asp-controller="Dashboard"
                       asp-action="Index"
                       title="Refresh templates"
                       aria-label="Refresh templates">↻</a>

                </div>

                <input type="hidden"
                       id="templateId"
                       name="templateId"
                       required />

                <div class="field-hint" id="templateHint">
                    Template ID: Not selected
                </div>

            </div>

            <div class="separator"></div>

            <div class="field">

                <label for="recipientFile">Recipient File</label>

                <div class="file-row file-picker-row"
                     data-file-picker="recipientFile"
                     role="button"
                     tabindex="0"
                     aria-label="Choose recipient file">

                    <div class="file-name" id="recipientName">
                        No recipient file selected
                    </div>

                    <div class="icon-button attach"
                         aria-hidden="true">
                        <img src="~/images/xls.png"
                             alt=""
                             width="40"
                             height="40" />
                    </div>

                    <input class="visually-hidden file-picker-input"
                           id="recipientFile"
                           name="recipientFile"
                           type="file"
                           accept=".xlsx,.xls,.csv,.tsv"
                           aria-label="Choose recipient file" />

                    <button class="icon-button clear"
                            type="button"
                            data-clear="recipientFile"
                            data-display="recipientName"
                            title="Remove file"
                            aria-label="Remove recipient file">
                        ×
                    </button>

                </div>

                <div class="field-hint">
                    Supported: XLSX, XLS, CSV, TSV
                </div>

            </div>

            <div class="field">

                <label for="headerImage">
                    Header Image
                    <span class="optional">(Optional)</span>
                </label>

                <div class="file-row file-picker-row"
                     data-file-picker="headerImage"
                     role="button"
                     tabindex="0"
                     aria-label="Choose header image">

                    <div class="file-name" id="headerImageName">
                        No header image selected
                    </div>

                    <div class="icon-button image-button"
                         aria-hidden="true">
                        <img src="~/images/picture.png"
                             alt=""
                             width="40"
                             height="40" />
                    </div>

                    <input class="visually-hidden file-picker-input"
                           id="headerImage"
                           name="headerImage"
                           type="file"
                           accept=".jpg,.jpeg,.png,image/jpeg,image/png"
                           aria-label="Choose header image" />

                    <button class="icon-button clear"
                            type="button"
                            data-clear="headerImage"
                            data-display="headerImageName"
                            title="Remove image"
                            aria-label="Remove header image">
                        ×
                    </button>

                </div>

                <div class="field-hint">
                    Supported: JPG, JPEG, PNG
                </div>

            </div>

            <button type="submit"
                    class="button-primary send-button"
                    id="sendButton">
                ➤ Send Bulk Messages
            </button>

            <div class="form-validation"
                 id="formValidation"
                 role="alert"></div>

        </form>

    </section>
</div>
