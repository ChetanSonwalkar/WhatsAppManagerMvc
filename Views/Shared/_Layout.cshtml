
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CIIT WhatsApp Manager</title>
    @* <title>@ViewData["Title"] - CIIT WhatsApp Manager</title> *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Dashboard" asp-action="Index">
            @* <span class="brand-icon">WA</span> *@
            <div class="hero-mark">
                <img src="~/images/logo.png"
                     alt="CIIT Institute Logo" class="hero-mark"/>
            </div>
            <span>CIIT WhatsApp Manager </span>
        </a>
        <span class="topbar-subtitle">Bulk Messaging Dashboard</span>
    </header>

    <main class="page-shell">
        @RenderBody()
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
